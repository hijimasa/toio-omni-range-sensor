<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>toio_omni_range</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for the toio omnidirectional range sensor: BLE scans as sensor_msgs/LaserScan</description>
  <maintainer email="hijimasa@gmail.com">hijimasa</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Not resolvable via rosdep: bleak is also required at runtime.
       Install it with: pip install bleak (the docker/ image already has it) -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
